# Copier ce fichier en .env :  cp .env.example .env  puis compléter

# Adresse du serveur (IP du PC qui lance uvicorn, port 8000)
SERVEUR_URL=http://192.168.1.10:8000

# Identifiant et token du boîtier : à créer dans l'interface web,
# Configuration > Boîtiers de pointage, puis copier le token ici
DEVICE_ID=RPI-001
API_TOKEN=

# Secondes entre deux synchronisations
INTERVALLE_SYNCHRO=10
# Une carte enregistrée ne peut pas repasser avant ce délai (secondes),
# sauf si l'enregistrement a échoué (LED rouge)
ANTI_REBOND_S=60

# 1 = LED rouge pour une carte associée à aucun étudiant (le bip est quand même enregistré)
# Mettre 0 sur le boîtier d'accueil, qui sert à enregistrer les nouvelles cartes
CONTROLE_CARTES=1

# 1 = le buzzer sonne quand la broche est à LOW (cas du module du boîtier)
# 0 = le buzzer sonne quand la broche est à HIGH
BUZZER_INVERSE=1
